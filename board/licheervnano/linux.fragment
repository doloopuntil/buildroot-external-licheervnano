CONFIG_CV1800_MBOX=y
CONFIG_CV1800B_EPHY_INIT=y
CONFIG_MDIO_BUS_MUX_MMIOREG=m
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=m
CONFIG_WLAN=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_PWRSEQ_SIMPLE=y
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HCIBTSDIO=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=m
CONFIG_SOPHGO_CV1800B_ADC=m
CONFIG_SOPHGO_CV1800_RTCSYS=m
CONFIG_RTC_DRV_CV1800=m
CONFIG_DW_WATCHDOG=m
CONFIG_WATCHDOG_SYSFS=y
CONFIG_CV1800_THERMAL=m
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=m
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_DISK=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y
CONFIG_LEDS_TRIGGER_NETDEV=y
CONFIG_LEDS_TRIGGER_PANIC=y
CONFIG_LEDS_TRIGGER_ACTIVITY=y
CONFIG_LEDS_TRIGGER_CPU=y
CONFIG_LEDS_USER=m
CONFIG_USB_DWC2=m
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_SND=m
CONFIG_SND_SOC=m
CONFIG_SND_SOC_CV1800B_TDM=m
CONFIG_SND_SOC_CV1800B_ADC_CODEC=m
CONFIG_SND_SOC_CV1800B_DAC_CODEC=m
CONFIG_SND_SOC_SIMPLE_CARD=m
CONFIG_SOPHGO_CV1800B_DMAMUX=m
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=m
CONFIG_USB_CONFIGFS=m
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
